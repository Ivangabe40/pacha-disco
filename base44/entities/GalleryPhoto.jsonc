{
  "name": "GalleryPhoto",
  "type": "object",
  "properties": {
    "photo_url": {
      "type": "string",
      "description": "URL de la foto"
    },
    "caption": {
      "type": "string",
      "description": "Descripci\u00f3n de la foto"
    },
    "event_name": {
      "type": "string",
      "description": "Evento relacionado"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de la foto"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n extendida de la foto",
      "maxLength": 1000
    }
  },
  "required": [
    "photo_url"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}