{
  "name": "GalleryAlbum",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo del \u00e1lbum (ej: S\u00e1bado 5 de Abril)"
    },
    "link": {
      "type": "string",
      "description": "URL del \u00e1lbum de fotos externo"
    },
    "cover_url": {
      "type": "string",
      "description": "Imagen de portada (opcional)"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n del \u00e1lbum",
      "maxLength": 1000
    }
  },
  "required": [
    "title",
    "link"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}