{
  "name": "VIPReservation",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del solicitante"
    },
    "phone": {
      "type": "string",
      "description": "Tel\u00e9fono de contacto"
    },
    "email": {
      "type": "string",
      "description": "Email de contacto"
    },
    "event_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha del evento"
    },
    "sector": {
      "type": "string",
      "enum": [
        "Mesa VIP Planta Baja",
        "Mesa VIP Planta Alta",
        "Sector Privado",
        "Barra Exclusiva",
        "Reservado Premium"
      ],
      "description": "Sector o mesa seleccionada"
    },
    "guests": {
      "type": "number",
      "description": "Cantidad de personas"
    },
    "message": {
      "type": "string",
      "description": "Mensaje o pedidos especiales"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendiente",
        "confirmada",
        "cancelada"
      ],
      "default": "pendiente",
      "description": "Estado de la reserva"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n adicional de la reserva",
      "maxLength": 1000
    }
  },
  "required": [
    "name",
    "phone",
    "event_date",
    "sector",
    "guests"
  ]
}