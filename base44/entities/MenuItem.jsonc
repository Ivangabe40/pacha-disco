{
  "name": "MenuItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del producto"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n breve"
    },
    "price": {
      "type": "number",
      "description": "Precio en ARS"
    },
    "category": {
      "type": "string",
      "enum": [
        "Sin Alcohol",
        "Vodkas",
        "Vermuts",
        "Cervezas",
        "Gin",
        "Cl\u00e1sicos",
        "Whiskies",
        "Bottle Service",
        "Espumosos"
      ],
      "description": "Categor\u00eda del producto"
    },
    "is_available": {
      "type": "boolean",
      "default": true,
      "description": "Disponible"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Destacado"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Orden de aparici\u00f3n"
    }
  },
  "required": [
    "name",
    "price",
    "category"
  ]
}