{
  "name": "PachaCoins",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email del usuario"
    },
    "user_name": {
      "type": "string",
      "description": "Nombre del usuario"
    },
    "coins": {
      "type": "number",
      "default": 0,
      "description": "Saldo actual de Pach\u00e1 Coins"
    },
    "total_earned": {
      "type": "number",
      "default": 0,
      "description": "Total de coins ganados hist\u00f3ricamente"
    },
    "tickets_count": {
      "type": "number",
      "default": 0,
      "description": "Cantidad de eventos asistidos"
    },
    "notes": {
      "type": "string",
      "description": "Notas del administrador"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}