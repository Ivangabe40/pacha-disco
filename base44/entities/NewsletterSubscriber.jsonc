{
  "name": "NewsletterSubscriber",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email del suscriptor"
    },
    "name": {
      "type": "string",
      "description": "Nombre del suscriptor (opcional)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Suscripci\u00f3n activa"
    },
    "description": {
      "type": "string",
      "description": "Notas sobre el suscriptor",
      "maxLength": 1000
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}