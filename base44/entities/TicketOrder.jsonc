{
  "name": "TicketOrder",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "ID del evento"
    },
    "event_title": {
      "type": "string",
      "description": "Nombre del evento"
    },
    "quantity": {
      "type": "number",
      "default": 1,
      "description": "Cantidad de entradas"
    },
    "unit_price": {
      "type": "number",
      "description": "Precio unitario en ARS"
    },
    "total": {
      "type": "number",
      "description": "Total de la orden"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Estado de la orden"
    },
    "preference_id": {
      "type": "string",
      "description": "ID de preferencia de Mercado Pago"
    },
    "payment_id": {
      "type": "string",
      "description": "ID de pago de Mercado Pago"
    },
    "external_reference": {
      "type": "string",
      "description": "Referencia externa enviada a Mercado Pago (igual al ID de la orden)"
    },
    "buyer_name": {
      "type": "string",
      "description": "Nombre del comprador"
    },
    "buyer_email": {
      "type": "string",
      "description": "Email del comprador"
    },
    "buyer_phone": {
      "type": "string",
      "description": "Tel\u00e9fono del comprador"
    },
    "ticket_type": {
      "type": "string",
      "enum": [
        "anticipada",
        "reserva"
      ],
      "default": "anticipada",
      "description": "Tipo de entrada"
    },
    "approval_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora de aprobaci\u00f3n del pago"
    },
    "description": {
      "type": "string",
      "description": "Notas o descripci\u00f3n adicional de la orden",
      "maxLength": 1000
    }
  },
  "required": [
    "event_id",
    "event_title",
    "quantity",
    "unit_price",
    "total"
  ]
}