{
  "name": "TicketOrder",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "description": "ID del evento"
    },
    "event_title": {
      "type": "string",
      "description": "Nombre del evento"
    },
    "quantity": {
      "type": "number",
      "default": 1,
      "description": "Cantidad de entradas"
    },
    "unit_price": {
      "type": "number",
      "description": "Precio unitario en ARS"
    },
    "total": {
      "type": "number",
      "description": "Total de la orden"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Estado de la orden"
    },
    "preference_id": {
      "type": "string",
      "description": "ID de preferencia de Mercado Pago"
    },
    "payment_id": {
      "type": "string",
      "description": "ID de pago de Mercado Pago"
    },
    "buyer_email": {
      "type": "string",
      "description": "Email del comprador"
    }
  },
  "required": [
    "event_id",
    "event_title",
    "quantity",
    "unit_price",
    "total"
  ]
}